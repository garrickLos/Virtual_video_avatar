{
  "name": "Virtual-character",
  "version": "0.1.8-alpha.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.5.0"
  },
  "description": "",
  "dependencies": {
    "electron-store": "^6.0.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.jouwnaam.virtueelcharacter",
    "productName": "Virtual video character",
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme}",
      "!**/*.map"
    ],
    "publish": {
      "provider": "github",
      "owner": "garrickLos",
      "repo": "Virtual_video_avatar"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
