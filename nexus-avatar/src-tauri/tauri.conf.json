{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nexus avatar",
  "version": "0.1.8-alpha.0",
  "identifier": "com.icicle.nexusAvatar",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/vva-app/browser"
  },
  "app": {
    "windows": [
      {
        "title": "nexus avatar",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
